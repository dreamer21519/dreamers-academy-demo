<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dreamers Academy – Larry the Owl Lesson</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#fffaf3;--card:#ffffff;--ink:#1b2a49;--muted:#5a6785;--orange:#f57c00;--orange-soft:#ffe9d1;--ok:#2e7d32;--bad:#b3261e;--line:#f0dcc3}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#111a2e;--card:#1a2742;--ink:#f4efe6;--muted:#a9b4cc;--orange:#ff9a3d;--orange-soft:#3a2c1c;--ok:#7bd88a;--bad:#ff8a80;--line:#2c3b5c}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#111a2e;--card:#1a2742;--ink:#f4efe6;--muted:#a9b4cc;--orange:#ff9a3d;--orange-soft:#3a2c1c;--ok:#7bd88a;--bad:#ff8a80;--line:#2c3b5c}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:560px;margin:0 auto;padding:16px}
header{text-align:center;padding:8px 0 4px}
.brand{font-weight:800;letter-spacing:.04em;font-size:13px;color:var(--orange);text-transform:uppercase}
h1{font-size:24px;margin:4px 0 2px}
.sub{color:var(--muted);font-size:15px;margin:0}
.bar{height:10px;background:var(--orange-soft);border-radius:99px;margin:14px 0;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--orange);border-radius:99px;transition:width .4s}
.card{background:var(--card);border:2px solid var(--line);border-radius:20px;padding:20px;margin-bottom:14px}
.card h2{margin:0 0 8px;font-size:22px}
.owl{text-align:center;line-height:1}.larry{width:140px;max-width:60%;height:auto}.logo{display:block;width:84px;height:84px;border-radius:50%;margin:0 auto 6px}
.scene{font-size:36px;text-align:center;letter-spacing:.2em;padding:12px;background:var(--orange-soft);border-radius:14px;margin:10px 0}
.read{background:var(--orange-soft);border-left:6px solid var(--orange);padding:12px 14px;border-radius:10px;margin:10px 0}
.tip{font-size:14px;color:var(--muted);margin-top:12px}
.choices{display:grid;gap:10px;margin-top:12px}
button{font:inherit;font-weight:700;border:2px solid var(--orange);background:var(--card);color:var(--ink);padding:14px;border-radius:14px;cursor:pointer;min-height:52px;text-align:center}
button:hover{background:var(--orange-soft)}
button.primary{background:var(--orange);color:#1b2a49;margin-top:14px;width:100%}
button.ok{border-color:var(--ok);background:var(--orange-soft)}
button.bad{border-color:var(--bad)}
button:focus-visible,input:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.fb{min-height:28px;margin-top:10px;font-weight:700}
input{font:inherit;width:100%;padding:12px;border-radius:12px;border:2px solid var(--line);background:var(--card);color:var(--ink);margin-top:8px}
.badge{text-align:center;border:3px dashed var(--orange);border-radius:20px;padding:18px;margin-top:10px}
.link{background:none;border:none;color:var(--muted);text-decoration:underline;font-weight:400;min-height:0;padding:8px;width:100%;margin-top:6px}
.chips{display:grid;grid-template-columns:1fr 1fr;gap:8px}.chip{font-size:16px;min-height:48px;padding:10px}button:disabled{opacity:.5;cursor:default}label{display:block}
.jr{display:grid;grid-template-columns:1fr 52px 36px 52px;align-items:center;gap:8px;margin:8px 0}.jr b{text-align:center;font-size:22px}
:root{--ot:#b85500}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--ot:#ff9a3d}}:root[data-theme="dark"]{--ot:#ff9a3d}
.acad img{display:block;width:100%;max-width:340px;margin:0 auto 10px;border-radius:16px}
.chip2{display:inline-block;padding:4px 12px;border-radius:99px;background:var(--orange-soft);color:var(--ink);font-weight:700;font-size:13px;letter-spacing:.05em;text-transform:uppercase}
.tier{border:2px solid var(--line);border-radius:16px;padding:16px;margin-top:12px}.tier h3{margin:8px 0 0;font-size:22px}.tier .lead{margin:0;font-weight:700;color:var(--ot)}
.soon{display:inline-block;border:2px solid var(--ink);border-radius:99px;padding:2px 10px;font-weight:700;font-size:13px}
.ck{display:flex;gap:10px;align-items:flex-start;margin:10px 0}.ck input{width:22px;height:22px;margin-top:2px}.ck label{margin:0;font-weight:400;font-size:15px}
select{font:inherit;width:100%;padding:12px;border-radius:12px;border:2px solid var(--line);background:var(--card);color:var(--ink);margin-top:8px}
.card>label{margin-top:12px;font-weight:700;font-size:15px}
.academy-brand{display:flex;flex-direction:column;align-items:center;gap:10px;margin:0 auto 12px}.academy-logo{display:block;width:min(340px,90%);height:auto;object-fit:contain}.seed-logo{display:block;width:min(250px,75%);height:auto;object-fit:contain}
.tier-art{display:block;width:100%;max-width:370px;height:auto;object-fit:contain;margin:0 auto 14px;border-radius:12px}.academy-brand{margin-bottom:12px}
</style>
</head>
<body>
<main>
<header>
<div class="academy-brand"><img class="academy-logo" src="data:image/jpeg;base64," alt="Dreamers Academy official logo"></div><div class="brand">The Young Dreamers Collection</div>
<h1>Dreamers Academy</h1>
<p class="sub">Prototype preview · coming soon</p>
</header>
<div class="bar" role="progressbar" aria-label="Lesson progress" aria-valuemin="0" aria-valuemax="100"><i id="prog"></i></div>
<div id="app" aria-live="polite"></div>
<p class="tip" style="text-align:center">Prototype lesson · A grown-up can read along with your young dreamer.</p>
</main>
<script>
var LARRY='data:image/png;base64,';
function lg(){return '<img class="larry" src="'+LARRY+'" alt="Larry the Owl, a small brown owl with big red glasses, waving">';}
var L1=[{t:'intro'},{t:'look'},{t:'listen'},{t:'learn'},{t:'done'}];
var L2=[{t:'intro2'},{t:'pick'},{t:'build'},{t:'done2'}];
var L3=[{t:'intro3'},{t:'goal'},{t:'jars'},{t:'weeks'},{t:'done3'}];
var GOALS=[['📚','new books',6],['🎨','an art set',8],['🌱','a garden kit',5]],goal3=-1,jars={save:0,share:0,spend:0};
var L4=[{t:'m1intro'},{t:'m1learn'},{t:'m1act'},{t:'m1quiz'},{t:'m1cert'}];
var steps=[{t:'home'}],i=0,saved='',sortI=0,certName='';
var ACAD='data:image/jpeg;base64,';
function ac(){return '<img src="'+ACAD+'" alt="Dreamers Academy logo: four young dreamers looking toward a sunrise above an open book. Learn, Create, Build, Lead. The Young Dreamers Collection.">';}
var pk={who:-1,where:-1,what:-1},story2={next:'',lesson:''};
var OPT={who:[['🐰','a little bunny'],['🐢','a kind turtle'],['🦊','a clever fox'],['🐜','a tiny ant']],
where:[['🌳','in a big forest'],['🌊','by the ocean'],['🏙️','in a busy city'],['🌙','under the moon']],
what:[['🔍','found a mystery'],['🎁','found something special'],['🤝','needed a new friend'],['❓','had a big question']]};
function sent(){return 'One day, '+OPT.who[pk.who][1]+' '+OPT.where[pk.where][1]+' '+OPT.what[pk.what][1]+'.';}
function left(){return 10-jars.save-jars.share-jars.spend;}
function goalView(){
app.innerHTML='<div class="card"><h2>🎯 Pick a dream goal</h2><p>Dreams take a plan. What would you like to save for? Each goal costs coins.</p><div class="choices">'+GOALS.map(function(g,n){return '<button class="chip'+(goal3===n?' ok':'')+'" data-n="'+n+'" aria-pressed="'+(goal3===n)+'">'+g[0]+' '+g[1]+' · '+g[2]+' coins</button>';}).join('')+'</div><button class="primary" id="gn"'+(goal3>=0?'':' disabled')+'>Next ➜</button></div>';
app.querySelectorAll('.chip').forEach(function(b){b.onclick=function(){goal3=+b.dataset.n;goalView();};});
document.getElementById('gn').onclick=function(){go(2);};
}
function jarsView(){
var g=GOALS[goal3],l=left();
var rows=[['save','🏦 Save'],['share','💛 Share'],['spend','🛍️ Spend']].map(function(r){var k=r[0];return '<div class="jr"><span>'+r[1]+'</span><button class="chip" data-k="'+k+'" data-d="-1" aria-label="Remove a coin from '+r[1]+'"'+(jars[k]===0?' disabled':'')+'>−</button><b>'+jars[k]+'</b><button class="chip" data-k="'+k+'" data-d="1" aria-label="Add a coin to '+r[1]+'"'+(l===0?' disabled':'')+'>+</button></div>';}).join('');
var msg=l>0?'Coins left to place: <b>'+l+'</b>':(jars.save===0?'Put at least 1 coin in Save so you can reach your goal!':'🎉 All coins placed! Saving '+jars.save+' a week, you reach your '+g[1]+' goal in <b>'+Math.ceil(g[2]/jars.save)+' weeks</b>.');
app.innerHTML='<div class="card"><h2>🪙 Plan your 10 coins</h2><p>Goal: '+g[0]+' '+g[1]+' ('+g[2]+' coins). Each week you get 10 coins. Split them into three jars.</p>'+rows+'<p class="fb" style="color:var(--ink)">'+msg+'</p><button class="primary" id="jn"'+(l===0&&jars.save>0?'':' disabled')+'>Next ➜</button><p class="tip">Grown-up tip: ask who your child would like to share with, and why.</p></div>';
app.querySelectorAll('.jr .chip').forEach(function(b){b.onclick=function(){jars[b.dataset.k]+=+b.dataset.d;jarsView();};});
document.getElementById('jn').onclick=function(){go(3);};
}
var SORT=[['💧','Clean water','need'],['🏠','A safe home','need'],['🧸','A new toy','want'],['🍦','Ice cream','want'],['🧥','Warm clothes','need'],['🎮','A video game','want']];
function homeGo(){steps=[{t:'home'}];go(0);}
function tiers(){
var T=[
['Elementary school','Dream Seed','Learning to Think','Discover the language of money, habits, choices, teamwork, and creative ideas through stories, visuals, and hands-on activities.','#F2C14E','#1B2A49'],
['Middle school','Dream Builder','Learning to Build','Apply skills through budgets, plans, and projects, and test entrepreneurial ideas.','#9CCBF2','#1B2A49'],
['High school','Dreamer Leadership','Learning to Lead','Make informed decisions and lead real initiatives, from financial planning to a business concept or community project.','#1B2A49','#FFFFFF']];
var tierImages=['data:image/jpeg;base64,','data:image/jpeg;base64,','data:image/jpeg;base64,'];
return T.map(function(t,n){return '<div class="tier"><img class="tier-art" src="'+tierImages[n]+'" alt="'+t[1]+' official '+t[0]+' artwork"><span class="chip2" style="background:'+t[4]+';color:'+t[5]+'">'+t[0]+'</span><h3>'+t[1]+'</h3><p class="lead">'+t[2]+'</p><p>'+t[3]+'</p><span class="soon">Coming soon'+(n===0?' · sample below':'')+'</span>'+(n===0?'<button id="trySeed" class="primary" style="margin-top:12px">Try a Seed sample module</button>':'')+'</div>';}).join('');
}
function waitlist(){
return '<div class="card"><h2>Join the waitlist</h2><p class="tip" style="margin-top:0">For parents, guardians, and educators.</p><label for="wf">Parent or guardian first name</label><input id="wf" type="text"><label for="we">Parent or guardian email</label><input id="we" type="email"><label for="wa">How old is your child?</label><select id="wa"><option>Choose an age range</option><option>Under 5</option><option>5-7</option><option>8-10</option><option>11-13</option><option>Not sure yet</option></select><label for="wl">What would you most like your child to learn?</label><select id="wl"><option>Choose one</option><option>Reading and storytelling</option><option>Creativity</option><option>Money skills</option><option>Confidence and leadership</option><option>All of it</option></select><div class="ck"><input id="w1" type="checkbox"><label for="w1">Send me news about new books and events.</label></div><div class="ck"><input id="w2" type="checkbox"><label for="w2">I am a parent or guardian, and I agree to receive emails from The Young Dreamers Collection.</label></div><button class="primary" id="wj">Join the waitlist</button><div class="fb" id="wm"></div><p class="tip">This form is for parents and guardians only. We ask for your email and your child’s age range so we can send you the free lesson and Academy updates. We don’t ask children for personal information. You can unsubscribe at any time using the link in any email.</p></div>';
}
function actView(){
var it=SORT[sortI];
app.innerHTML='<div class="card"><h2>🧺 Need or want?</h2><p>Item '+(sortI+1)+' of '+SORT.length+'</p><div class="scene" role="img" aria-label="'+it[1]+'">'+it[0]+'</div><p style="text-align:center"><b>'+it[1]+'</b></p><div class="choices"><button data-a="need">A need</button><button data-a="want">A want</button></div><div class="fb" id="fb"></div><button class="primary" id="nxa" hidden>'+(sortI<SORT.length-1?'Next ➜':'Finish ➜')+'</button></div>';
var fb=document.getElementById('fb'),nx=document.getElementById('nxa'),bs=app.querySelectorAll('.choices button');
bs.forEach(function(b){b.onclick=function(){
if(b.dataset.a===it[2]){b.classList.add('ok');fb.textContent='⭐ Yes! '+it[1]+' is a '+it[2]+'.';fb.style.color='var(--ok)';nx.hidden=false;bs.forEach(function(x){x.disabled=true;});}
else{b.classList.add('bad');fb.textContent='Think again. Is it something we must have to live and be safe?';fb.style.color='var(--bad)';}
};});
nx.onclick=function(){if(sortI<SORT.length-1){sortI++;actView();}else{go(i+1);}};
}
function menuGo(){steps=[{t:'menu'}];go(0);}
function chips(k,label){var h='<p><b>'+label+'</b></p><div class="chips">';OPT[k].forEach(function(o,n){h+='<button class="chip'+(pk[k]===n?' ok':'')+'" data-g="'+k+'" data-n="'+n+'" aria-pressed="'+(pk[k]===n)+'">'+o[0]+' '+o[1]+'</button>';});return h+'</div>';}
function pickView(){
var ok=pk.who>=0&&pk.where>=0&&pk.what>=0;
app.innerHTML='<div class="card"><h2>🎨 Choose your story pieces</h2>'+chips('who','Who is in your story?')+chips('where','Where are they?')+chips('what','What happens?')+'<button class="primary" id="nx2"'+(ok?'':' disabled')+'>Next ➜</button></div>';
app.querySelectorAll('.chip').forEach(function(b){b.onclick=function(){pk[b.dataset.g]=+b.dataset.n;pickView();};});
document.getElementById('nx2').onclick=function(){go(2);};
}
try{saved=localStorage.getItem('yd_next')||'';}catch(e){}
var app=document.getElementById('app'),prog=document.getElementById('prog');
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]});}
function quiz(q,opts,ans){
var h='<div class="choices">';
opts.forEach(function(o,k){h+='<button data-k="'+k+'">'+o+'</button>';});
return h+'</div><div class="fb" id="fb"></div><button class="primary" id="next" hidden>Next ➜</button>';
}
function wire(ans){
var bs=app.querySelectorAll('.choices button'),fb=document.getElementById('fb'),nx=document.getElementById('next');
bs.forEach(function(b){b.onclick=function(){
if(+b.dataset.k===ans){b.classList.add('ok');fb.textContent='⭐ Great job, dreamer!';fb.style.color='var(--ok)';nx.hidden=false;bs.forEach(function(x){x.disabled=true;});}
else{b.classList.add('bad');fb.textContent='Almost! Look again and try another one.';fb.style.color='var(--bad)';}
};});
nx.onclick=function(){go(i+1);};
}
function go(n){i=n;render();window.scrollTo(0,0);}
function render(){
var pct=Math.round(i/Math.max(1,steps.length-1)*100);
prog.style.width=pct+'%';
prog.parentNode.setAttribute('aria-valuenow',pct);
prog.parentNode.style.display=steps.length>1?'':'none';
var s=steps[i].t,h='';
if(s==='home'){
app.innerHTML='<div class="card"><p style="text-align:center"><span class="chip2">Coming soon</span></p><h2 style="text-align:center">Learn. Create. Build. Lead.</h2><p>Dreamers Academy, an educational initiative of The Young Dreamers Collection, is where young minds will discover financial literacy, creativity, entrepreneurship, and leadership. Our three-tier pathway will help students grow from curious thinkers into capable builders and responsible leaders.</p><button class="primary" id="tryl">Try a sample lesson</button></div><div class="card"><h2>Three tiers, one learning journey</h2><p class="tip" style="margin-top:0">Plant the seed. Build the vision. Become the leader.</p>'+tiers()+'<p class="tip">Tier placement is based on school level, not a rigid age cutoff. Courses, pricing, and launch dates will be announced. Educational content only, not individualized financial advice.</p></div>'+waitlist()+'<p class="tip" style="text-align:center">Dreamers Academy is an educational initiative of The Young Dreamers Collection.</p>';
document.getElementById('tryl').onclick=menuGo;
document.getElementById('trySeed').onclick=function(){steps=L4;sortI=0;go(0);};
document.getElementById('wj').onclick=function(){var m=document.getElementById('wm');m.textContent='Layout preview only: this form is not connected yet, so nothing was sent or saved.';m.style.color='var(--ink)';};
}
else if(s==='m1intro'){
app.innerHTML='<div class="card"><div class="owl">'+lg()+'</div><span class="chip2" style="background:#F2C14E;color:#1B2A49">Dreamer Seed · Learning to Think</span><h2>Module 1: Money and Its Purpose</h2><p><b>Learning objective:</b> By the end, you can tell what money is for and sort needs from wants.</p><p>In this prototype module: a mini-lesson, a needs-versus-wants activity, a knowledge check, and a certificate.</p><p class="tip">The full module will also include a teaching video, a slide presentation, and a printable student notebook.</p><button class="primary" id="s1">Start module</button></div>';
document.getElementById('s1').onclick=function(){go(1);};
}
else if(s==='m1learn'){
app.innerHTML='<div class="card"><h2>📖 Mini-lesson</h2><div class="read"><b>Money is a tool.</b> People trade money for things they need and want.</div><div class="read"><b>A need</b> is something we must have to live and be safe, like water, food, a home, and warm clothes.</div><div class="read"><b>A want</b> is something nice to have, like a toy, a treat, or a game.</div><div class="read">People earn money by working. Then they choose how to use it. Choosing well is a dreamer skill!</div><p class="tip">Grown-up tip: ask your child to name one need and one want from today.</p><button class="primary" id="s2">Try the activity</button></div>';
document.getElementById('s2').onclick=function(){go(2);};
}
else if(s==='m1act'){sortI=0;actView();}
else if(s==='m1quiz'){
app.innerHTML='<div class="card"><h2>✅ Knowledge check</h2><p><b>Money is a tool we use to…</b></p>'+quiz('',['trade for things we need and want','hide and never use','grow on trees'],0)+'</div>';wire(0);
}
else if(s==='m1cert'){
try{localStorage.setItem('yd_done4','1');}catch(e){}
var dt=new Date().toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});
app.innerHTML='<div class="card"><h2>🎓 Your certificate</h2><label for="cn"><b>Type your first name (optional)</b></label><input id="cn" maxlength="30" value="'+esc(certName)+'"><div class="badge" style="margin-top:14px"><div class="owl">'+lg()+'</div><p style="margin:6px 0 0;font-size:14px;letter-spacing:.06em;text-transform:uppercase">Dreamers Academy</p><h2 style="margin:4px 0">Certificate of Completion</h2><p style="margin:0">This certifies that</p><p style="font-size:24px;font-weight:800;margin:4px 0" id="cname">'+esc(certName||'a Young Dreamer')+'</p><p style="margin:0">completed</p><p style="margin:4px 0"><b>Dreamer Seed · Module 1: Money and Its Purpose</b></p><p class="tip" style="margin:6px 0 0">'+dt+'</p></div><p class="tip">The name is shown only on this screen and is not saved.</p><button class="primary" id="back">Back to lessons</button></div>';
document.getElementById('cn').oninput=function(){certName=this.value;document.getElementById('cname').textContent=certName.trim()||'a Young Dreamer';};
document.getElementById('back').onclick=menuGo;
}
else if(s==='menu'){
var d1=null,d2=null,d3=null,d4=null;try{d4=localStorage.getItem('yd_done4');d1=localStorage.getItem('yd_done1');d2=localStorage.getItem('yd_done2');d3=localStorage.getItem('yd_done3');}catch(e){}
app.innerHTML='<div class="card"><div class="owl">'+lg()+'</div><h2>Try a lesson</h2><button class="primary" id="l4">Dreamer Seed · Module 1: Money and Its Purpose '+(d4?'✅':'')+'</button><p class="tip">Companion lessons with Larry</p><button class="primary" id="l1">1 · Look, Listen, Learn '+(d1?'✅':'')+'</button><button class="primary" id="l2">2 · Create Your Own Story '+(d2?'✅':'')+'</button><button class="primary" id="l3">3 · Save, Share, Dream '+(d3?'✅':'')+'</button><button class="link" id="hm">← Back to Academy home</button></div>';
document.getElementById('l1').onclick=function(){steps=L1;go(0);};
document.getElementById('l2').onclick=function(){steps=L2;pk={who:-1,where:-1,what:-1};go(0);};
document.getElementById('l3').onclick=function(){steps=L3;goal3=-1;jars={save:0,share:0,spend:0};go(0);};
document.getElementById('l4').onclick=function(){steps=L4;sortI=0;go(0);};
document.getElementById('hm').onclick=homeGo;
}
else if(s==='intro2'){
app.innerHTML='<div class="card"><div class="owl">'+lg()+'</div><h2>Dreamers are creators!</h2><p>Larry looks, listens, and learns. Now let’s <b>create</b>! You’ll pick the pieces, then finish a story all your own.</p><button class="primary" id="go2">Start creating</button></div>';
document.getElementById('go2').onclick=function(){go(1);};
}
else if(s==='intro3'){
app.innerHTML='<div class="card"><div class="owl">'+lg()+'</div><h2>Big dreams need a plan!</h2><p>Larry has a dream, and he knows dreams come true step by step. Today you’ll learn to <b>Save</b>, <b>Share</b>, and <b>Spend</b> wisely.</p><button class="primary" id="go3">Let’s plan!</button></div>';
document.getElementById('go3').onclick=function(){go(1);};
}
else if(s==='goal'){goalView();}
else if(s==='jars'){jarsView();}
else if(s==='weeks'){
app.innerHTML='<div class="card"><h2>🧮 Larry’s math</h2><p>Larry saves <b>2 coins</b> each week for a goal that costs <b>6 coins</b>.</p><p><b>How many weeks will it take?</b></p>'+quiz('',['2 weeks','3 weeks','6 weeks'],1)+'<p class="tip">Grown-up tip: count it out with real coins or buttons.</p></div>';wire(1);
}
else if(s==='done3'){
var g=GOALS[goal3];try{localStorage.setItem('yd_done3','1');}catch(e){}

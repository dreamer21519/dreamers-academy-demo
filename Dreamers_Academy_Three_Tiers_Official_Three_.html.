document.getElementById('again').onclick=menuGo;
}
else if(s==='intro'){
h='<div class="card"><div class="owl">'+lg()+'</div><h2>Hi, I’m Larry!</h2><p>Today we’ll use three super-powers: <b>Look</b>, <b>Listen</b>, and <b>Learn</b>. Ready to be a dreamer?</p><button class="primary" id="start">Let’s go!</button></div>';
